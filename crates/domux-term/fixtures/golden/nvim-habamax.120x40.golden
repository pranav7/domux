size 120x40
cursor row=0 col=4 visible=true shape=block blink=false
|  1 //! Key events as the client decodes them and the emulator encodes them.                                            |
|  2                                                                                                                     |
|  3 use bitflags::bitflags;                                                                                             |
|  4                                                                                                                     |
|  5 /// The logical key. `Char` carries the character as typed (Shift+a is `Char('A')` with                             |
|  6 /// `Mods::SHIFT`). Function keys are `F(1)` through `F(12)`.                                                       |
|  7 #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]                                                                  |
|  8 pub enum Key {                                                                                                      |
|  9     Char(char),                                                                                                     |
| 10     Enter,                                                                                                          |
| 11     Tab,                                                                                                            |
| 12     Backspace,                                                                                                      |
| 13     Escape,                                                                                                         |
| 14     Up,                                                                                                             |
| 15     Down,                                                                                                           |
| 16     Left,                                                                                                           |
| 17     Right,                                                                                                          |
| 18     Home,                                                                                                           |
| 19     End,                                                                                                            |
| 20     PageUp,                                                                                                         |
| 21     PageDown,                                                                                                       |
| 22     Insert,                                                                                                         |
| 23     Delete,                                                                                                         |
| 24     F(u8),                                                                                                          |
| 25 }                                                                                                                   |
| 26                                                                                                                     |
| 27 bitflags! {                                                                                                         |
| 28     #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]                                                     |
| 29     pub struct Mods: u8 {                                                                                           |
| 30         const SHIFT = 1 << 0;                                                                                       |
| 31         const CTRL = 1 << 1;                                                                                        |
| 32         const ALT = 1 << 2;                                                                                         |
| 33         const SUPER = 1 << 3;                                                                                       |
| 34     }                                                                                                               |
| 35 }                                                                                                                   |
| 36                                                                                                                     |
| 37 #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]                                                         |
| 38 pub enum KeyAction {                                                                                                |
